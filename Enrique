local function PlayGithubSound(url, filename, volume)
    local success, err = pcall(function()
        local assetLoader = getcustomasset or getsynasset

        if typeof(writefile) ~= "function" then
            error("writefile is not supported")
        end

        if typeof(assetLoader) ~= "function" then
            error("getcustomasset/getsynasset is not supported")
        end

        local path = filename .. ".mp3"

        writefile(path, HttpGet(url))

        local sound = Instance.new("Sound")
        sound.Name = filename
        sound.SoundId = assetLoader(path)
        sound.Volume = volume
        sound.Parent = workspace
        sound:Play()

        sound.Ended:Connect(function()
            sound:Destroy()
        end)
    end)

    if not success then
        warn("[Rebound] Sound failed: " .. tostring(err))
    end
end

