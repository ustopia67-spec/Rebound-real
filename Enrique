local function HttpGet(url)
    if typeof(CachedHttpGet) == "function" then
        return CachedHttpGet(url)
    end
    return game:HttpGet(url)
end

local function LoadRemote(url)
    local source = HttpGet(url)
    local fn, err = loadstring(source)
    if not fn then
        error("Failed to compile remote script: " .. tostring(err))
    end
    return fn()
end

